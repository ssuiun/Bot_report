# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:AAAA-your-telegram-bot-token

# Telegram ID первого администратора (можно узнать, написав боту /start до регистрации).
# Через запятую можно указать несколько ID.
SUPER_ADMIN_IDS=111111111

# ID чата/канала, куда бот будет дублировать уведомления
# (смена статусов, новые акты, чеки). Может совпадать с ID администратора.
LOG_CHAT_ID=111111111

# ID таблицы Google Sheets (из её URL):
# https://docs.google.com/spreadsheets/d/ЭТА_ЧАСТЬ/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Путь к JSON-файлу сервисного аккаунта Google (см. README.md, раздел "Настройка Google Sheets")
GOOGLE_CREDENTIALS_FILE=credentials.json

# (Необязательно) ID папки в Google Drive для фото чеков, из URL папки:
# https://drive.google.com/drive/folders/ЭТА_ЧАСТЬ
# Папку нужно создать в обычном (не сервисном) Google-аккаунте и открыть доступ
# сервисному аккаунту как "Редактор" — так же, как для таблицы Sheets.
GOOGLE_DRIVE_FOLDER_ID=

# Путь к файлу базы данных SQLite
DB_PATH=hr_bot.db
